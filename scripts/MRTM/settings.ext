		class MRTMMainCtrlsGroup: RscControlsGroupMRTM
		{
#define CTRLS_GROUP_WIDTH (40 * GUI_GRID_W)
#define CTRLS_GROUP_CENTER (CTRLS_GROUP_WIDTH * 0.5)
#define CTRLS_GROUP_OFFSET (-0.25 * GUI_GRID_H)

			type = CT_CONTROLS_GROUP;
			idc = SETTINGS_MAIN_GROUP_IDC;

			x = GUI_GRID_CENTER_X + 0 * GUI_GRID_W;
			y = GUI_GRID_CENTER_Y + 1.1 * GUI_GRID_H;
